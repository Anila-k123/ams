# Copy to .env and adjust. Defaults already target the local advocate_db.
# DEBUG defaults to False. With DEBUG off the app refuses to start unless
# SECRET_KEY is a real random value (not django-insecure-...):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Development machines set DEBUG=True and may keep the dev key below.
SECRET_KEY=django-insecure-advocate-dev-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: sign login tokens with their own key (defaults to SECRET_KEY).
# Changing whichever key signs tokens logs everyone out.
# JWT_SIGNING_KEY=
# HTTPS hardening - enable once AMS is served over HTTPS (the LAN is plain http):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_COOKIES=True
# BEHIND_HTTPS_PROXY=True

DB_NAME=PactPro_db
DB_USER=postgres
DB_PASSWORD=psql_password
DB_HOST=localhost
DB_PORT=5432

JWT_EXPIRATION_MS=86400000
# Includes the InstaDraft frontend origin (only needed if it ever calls AMS directly).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Defaults to ../Advocate-app-BE-main/uploads if unset
# DOCUMENT_UPLOAD_DIR=

# --- Email (SMTP) ------------------------------------------------------------
# Every outbound message uses this: password-reset OTPs, hearing and invoice
# reminders, appeal alerts, and the Communication test send.
#
# There are NO fallback credentials in settings.py any more. A real Gmail
# address and app password used to sit there as defaults, which put a live
# secret in a public repository. If these are unset, the app does not try to
# send and says so plainly instead of failing per-message.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
NOTIFICATION_SENDER_NAME=Advocate Case Management System

# --- OTP ---------------------------------------------------------------------
# Salt for the stored password-reset OTP hash. Falls back to SECRET_KEY when
# blank, so it is never accidentally unsalted. Set it to rotate independently.
OTP_SALT=

# --- WhatsApp ----------------------------------------------------------------
# Off. There is no Meta Business API integration; the sender was a mock that
# recorded 'SENT' without sending. Leave disabled until an account and message
# templates are actually approved.
WHATSAPP_ENABLED=False
WHATSAPP_VERIFY_TOKEN=

# --- AI assistant & document summaries ---------------------------------------
# The AI assistant AND the document-summary feature share one LLM backend.
# LLM_PROVIDER selects it:
#   openai - OpenAI Chat Completions (set OPENAI_API_KEY)  <- the "online" option
#   gemini - Google Gemini's OpenAI-compatible endpoint (set GEMINI_API_KEY)
#   local  - a locally-hosted model exposed over an ngrok tunnel (set LLM_BASE_URL)
LLM_PROVIDER=openai

# openai backend (online)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
# OPENAI_BASE_URL=https://api.openai.com/v1

# gemini backend
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# local backend
# LLM_BASE_URL=https://xxxx.ngrok-free.app
# LLM_MODEL=local-model
# LLM_API_KEY=
# LLM_OPENAI_PATH=/v1/chat/completions

# shared
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=600

# Document summaries: generated in the background on upload (PDF/DOCX/TXT).
# Set SUMMARY_ENABLED=False to turn the feature off entirely.
SUMMARY_ENABLED=True
# SUMMARY_MAX_CHARS=24000

# --- Registration -----------------------------------------------------------
# Public self-signup. OFF, deliberately: /api/advocates/signup had no
# authentication, so anyone could create a working account. Such an account got
# no roles - cases and clients stayed closed - but 66 endpoints are gated only
# on "any signed-in advocate", including the Acts corpus and the court-search
# proxy that drives the scraper under this server's IP.
#
# Accounts are created by an administrator in User Management. Before turning
# this back on, add email verification.
ALLOW_PUBLIC_SIGNUP=False


# --- Court case lookup (the separate scraper service; courtsearch/client.py) ---
# Must point at the scraper itself. Anything else answering there (e.g. another
# app's HTML 404) is treated as "court lookup unavailable".
COURT_API_BASE=http://localhost:8000

# --- Drafting (merged from InstaDraft; docs/merge-plan, docs/OPERATIONS.md) ---
# Drafting shares the main database (schema "drf"); it needs the pgvector extension.
# Where drafting keeps uploaded reference documents and templates. Served only
# through the API (drafting/files.py), never as public /media.
# DRAFTING_MEDIA_ROOT=/srv/ams/drafting-media
# Drafting's own model settings. DRAFTING_-prefixed because the AMS assistant uses
# the plain LLM_* / GEMINI_* names with different meanings.
DRAFTING_LLM_ACTIVE=gemini
DRAFTING_GEMINI_API_KEY=
DRAFTING_GEMINI_MODEL=gemini-2.0-flash
DRAFTING_ANTHROPIC_API_KEY=
DRAFTING_OPENAI_API_KEY=
DRAFTING_EMBED_MODEL=nomic-ai/nomic-embed-text-v1
DRAFTING_EMBED_DIM=768
DRAFTING_SARVAM_API_KEY=
DRAFTING_GOOGLE_TRANSLATE_API_KEY=
DRAFTING_HF_TOKEN=

# --- Background jobs (drafting document processing / generation) ---
# PERMANENT: CELERY_TASK_ALWAYS_EAGER=False + Redis (REDIS_URL) + a Celery worker.
# STOPGAP (True): the API runs jobs in its own separate worker process
# (DRAFTING_JOB_RUNNER=process; 'thread' = old in-web-server threads, debug only).
# See docs/OPERATIONS.md, "Background jobs".
CELERY_TASK_ALWAYS_EAGER=True
REDIS_URL=redis://localhost:6379/0
DRAFTING_JOB_RUNNER=process
DRAFTING_JOB_WORKERS=1

# AI usage metering: price per 1M tokens [input, output] by model, for cost estimates in
# manage.py llm_usage and /api/usage/summary. Usage is recorded whether or not this is set.
LLM_PRICES={"gpt-4o-2024-08-06": [2.5, 10], "gemini-2.5-flash": [0.3, 2.5]}
LLM_PRICE_CURRENCY=USD

# Lisa privacy masking (assistant/privacy.py). Always on for openai/gemini;
# for the local model it can be switched off with False.
ASSISTANT_MASK_LOCAL=True

# Lisa tool calling: auto = on for openai/gemini, off for the local model
# (which then gets the pre-built context brief). on / off to force.
ASSISTANT_TOOL_CALLING=auto

# Task reminders: an open task is flagged this many days before its deadline
# (then on the due date, then daily while overdue).
TASK_REMINDER_DAYS=2

# --- Draft PDF export (docs/DRAFT_EXPORT.md) ---
# LibreOffice converts the Word export to PDF. Blank = found on PATH or in the usual
# install folder (C:\Program Files\LibreOffice\program\soffice.exe, /usr/bin/soffice).
# Court order sync: court cases fetched at once per round (docs/ORDER_SYNC.md). Raise slowly.
# ORDER_SYNC_WORKERS=3
# Without LibreOffice, PDF export answers 503 and the editor falls back to printing.
# LIBREOFFICE_PATH=

# --- Platform operators (docs/PLATFORM.md) ---
# Fernet key that encrypts operator authenticator seeds. Independent of SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up with the database; losing it means re-enrolling every operator (platform_operator reset-mfa).
# PLATFORM_MFA_KEY=

# --- Subscriptions (docs/SUBSCRIPTIONS.md) ---
# Development / test installs only (ignored unless DEBUG=True): firms marked as
# synthetic test firms may use DRAFT (unapproved) plans. Never on for customers.
# SUBSCRIPTION_TEST_PLANS=False

# The redline of an ONLYOFFICE draft in its own look runs LibreOffice's Compare Document from LibreOffice's
# Python (beside soffice on Windows; on Linux python3 with the python3-uno package). Blank = found there.
# LIBREOFFICE_PYTHON=
# Client review (docs/CLIENT_REVIEW.md): let clients mark up their copy in the portal's editor. Off: they download,
# edit in their own Word and upload back.
# CLIENT_REVIEW_EDITOR=False

# ONLYOFFICE Docs (draft editor, docs/ONLYOFFICE_PLAN.md)
# URL the browser uses / URL the backend uses / AMS backend URL as the document server reaches it.
ONLYOFFICE_URL=http://192.168.1.36:8085
ONLYOFFICE_INTERNAL_URL=http://127.0.0.1:8085
# Same value as services.CoAuthoring.secret.inbox.string in the server's config\local.json.
ONLYOFFICE_JWT_SECRET=
AMS_INTERNAL_URL=http://192.168.1.36:8080
# tiptap (current editor) or onlyoffice.
DRAFT_EDITOR=tiptap
# True only with a licensed Developer Edition: PactPro logo / name / loading screen in the editor.
ONLYOFFICE_WHITE_LABEL=False
