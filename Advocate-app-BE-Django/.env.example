# Copy to .env and adjust. Defaults already target the local advocate_db.
SECRET_KEY=django-insecure-advocate-dev-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=advocate_db
DB_USER=postgres
DB_PASSWORD=psql_password
DB_HOST=localhost
DB_PORT=5432

JWT_EXPIRATION_MS=86400000
# Includes the InstaDraft frontend origin (only needed if it ever calls AMS directly).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Defaults to ../Advocate-app-BE-main/uploads if unset
# DOCUMENT_UPLOAD_DIR=

# --- Email (SMTP) ------------------------------------------------------------
# Every outbound message uses this: password-reset OTPs, hearing and invoice
# reminders, appeal alerts, and the Communication test send.
#
# There are NO fallback credentials in settings.py any more. A real Gmail
# address and app password used to sit there as defaults, which put a live
# secret in a public repository. If these are unset, the app does not try to
# send and says so plainly instead of failing per-message.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
NOTIFICATION_SENDER_NAME=Advocate Case Management System

# --- OTP ---------------------------------------------------------------------
# Salt for the stored password-reset OTP hash. Falls back to SECRET_KEY when
# blank, so it is never accidentally unsalted. Set it to rotate independently.
OTP_SALT=

# --- WhatsApp ----------------------------------------------------------------
# Off. There is no Meta Business API integration; the sender was a mock that
# recorded 'SENT' without sending. Leave disabled until an account and message
# templates are actually approved.
WHATSAPP_ENABLED=False
WHATSAPP_VERIFY_TOKEN=

# --- AI assistant & document summaries ---------------------------------------
# The AI assistant AND the document-summary feature share one LLM backend.
# LLM_PROVIDER selects it:
#   openai - OpenAI Chat Completions (set OPENAI_API_KEY)  <- the "online" option
#   gemini - Google Gemini's OpenAI-compatible endpoint (set GEMINI_API_KEY)
#   local  - a locally-hosted model exposed over an ngrok tunnel (set LLM_BASE_URL)
LLM_PROVIDER=openai

# openai backend (online)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
# OPENAI_BASE_URL=https://api.openai.com/v1

# gemini backend
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# local backend
# LLM_BASE_URL=https://xxxx.ngrok-free.app
# LLM_MODEL=local-model
# LLM_API_KEY=
# LLM_OPENAI_PATH=/v1/chat/completions

# shared
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=600

# Document summaries: generated in the background on upload (PDF/DOCX/TXT).
# Set SUMMARY_ENABLED=False to turn the feature off entirely.
SUMMARY_ENABLED=True
# SUMMARY_MAX_CHARS=24000

# --- Registration -----------------------------------------------------------
# Public self-signup. OFF, deliberately: /api/advocates/signup had no
# authentication, so anyone could create a working account. Such an account got
# no roles - cases and clients stayed closed - but 66 endpoints are gated only
# on "any signed-in advocate", including the Acts corpus and the court-search
# proxy that drives the scraper under this server's IP.
#
# Accounts are created by an administrator in User Management. Before turning
# this back on, add email verification.
ALLOW_PUBLIC_SIGNUP=False


# --- Court case lookup (the separate scraper service; courtsearch/client.py) ---
# Must point at the scraper itself. Anything else answering there (e.g. another
# app's HTML 404) is treated as "court lookup unavailable".
COURT_API_BASE=http://localhost:8000

# --- Drafting (merged from InstaDraft; docs/merge-plan, docs/OPERATIONS.md) ---
# Separate Postgres database with the pgvector extension (schema "drf"). User,
# password, host and port default to the DB_* values above.
DRAFTING_DB_NAME=pactpro
# Where drafting keeps uploaded reference documents and templates. Served only
# through the API (drafting/files.py), never as public /media.
# DRAFTING_MEDIA_ROOT=/srv/ams/drafting-media
# Drafting's own model settings. DRAFTING_-prefixed because the AMS assistant uses
# the plain LLM_* / GEMINI_* names with different meanings.
DRAFTING_LLM_ACTIVE=gemini
DRAFTING_GEMINI_API_KEY=
DRAFTING_GEMINI_MODEL=gemini-2.0-flash
DRAFTING_ANTHROPIC_API_KEY=
DRAFTING_OPENAI_API_KEY=
DRAFTING_EMBED_MODEL=nomic-ai/nomic-embed-text-v1
DRAFTING_EMBED_DIM=768
DRAFTING_SARVAM_API_KEY=
DRAFTING_GOOGLE_TRANSLATE_API_KEY=
DRAFTING_HF_TOKEN=

# --- Background jobs (drafting document processing / generation) ---
# PERMANENT: CELERY_TASK_ALWAYS_EAGER=False + Redis (REDIS_URL) + a Celery worker.
# STOPGAP (True): the API runs jobs in its own separate worker process
# (DRAFTING_JOB_RUNNER=process; 'thread' = old in-web-server threads, debug only).
# See docs/OPERATIONS.md, "Background jobs".
CELERY_TASK_ALWAYS_EAGER=True
REDIS_URL=redis://localhost:6379/0
DRAFTING_JOB_RUNNER=process
DRAFTING_JOB_WORKERS=1
