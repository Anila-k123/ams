# Copy to .env and adjust. Defaults already target the local advocate_db.
SECRET_KEY=django-insecure-advocate-dev-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=advocate_db
DB_USER=postgres
DB_PASSWORD=psql_password
DB_HOST=localhost
DB_PORT=5432

JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Defaults to ../Advocate-app-BE-main/uploads if unset
# DOCUMENT_UPLOAD_DIR=
