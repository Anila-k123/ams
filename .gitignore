**/.env.local
**/.env.*.local
**/.env.production
recovery-codes.txt
*.pem
*.key

# ==========================
# Python / Django backend
# ==========================
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]
*.sqlite3
.pytest_cache/
.coverage
htmlcov/
celerybeat-schedule*
Advocate-app-BE-Django/staticfiles/
Advocate-app-BE-Django/media/
# Cached court PDFs (re-fetchable)
Advocate-app-BE-Django/court_pdf_cache/
# Raw dictionary source dumps (imported into the DB; re-fetchable via import_legal_terms --url)
Advocate-app-BE-Django/_data/

# Runtime storage: uploaded client documents, branding images, backup
# archives and demo-reset backups (uploads/demo-resets). Never source.
Advocate-app-BE-Django/uploads/
Advocate-app-BE-main/uploads/
Advocate-app-BE-Django/logs/
Advocate-app-BE-main/logs/

# Database dumps (docs/DEPLOYMENT.md step 2 creates PactPro_db.dump). They
# hold every client's data, so they must never reach the repository.
*.dump
*.backup
*.sql.gz

